#!/usr/bin/env bash
set -euo pipefail
unset DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export TMPDIR="${TMPDIR:-$root/.tmp/check/tmp}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$root/.tmp/check/target}"
mkdir -p -- "$TMPDIR" "$CARGO_TARGET_DIR"
cd -- "$root"
timeout 180 cargo test --offline --locked -j4 -- --test-threads=4
timeout 30 python3 -I -B tests/test_gate.py
cargo fmt --check
timeout 60 cargo clippy --offline --locked -j4 --all-targets -- -D warnings
bash -n scripts/pre-push scripts/check
